DATABASE_URL=postgres://user:password@localhost:5432/agenticsdk?sslmode=disable
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Primary LLM Provider
LLM_API_KEY=sk-guts-your-primary-key
LLM_BASE_URL=https://api.gutsai.id/v1
LLM_MODEL=gemini-3.7-flash

# Fallback LLM Provider
FALLBACK_LLM_API_KEY=sk-or-v1-your-openrouter-key
FALLBACK_LLM_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_LLM_MODEL=google/gemini-2.5-flash:free

# Embeddings Configuration
OPENAI_EMBEDDING_API_KEY=your-embedding-key
OPENAI_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
